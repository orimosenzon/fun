# Overpass road download, re-fetched on demand
.cache/

# Generated for import into My Maps
derech_kitzur*.kml

# wrangler leaves a cache wherever it is run from, and it names the
# Cloudflare account. This repo is public.
.wrangler/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# build_art.py imports build_places.py for its spread()
__pycache__/

# watch_objections.py: its memory of yesterday, and the daily reports
.watch/
reports/
objections_cron.log
hanadiv_cron.log

# watch_objections.py rewrites it every morning; the app reads the data repo's
# copy (--publish), and this one only serves ?local.
web/data/objections.json

# build_marked.py: the nightly OSM build goes to the data repo (--publish);
# the copy here only serves ?local, and 4 MB a night would bloat this repo.
web/data/marked.json
marked_cron.log
