rules_version = '2';
// Everyone can read the riddles and quizzes (the game is public); only Ori and Carmit can add, edit or delete.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['orimosenzon@gmail.com', 'carmitconsari@gmail.com'];
    }
    match /riddles/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.image is string
        && request.resource.data.answerType in ['text', 'image']
        && request.resource.data.answers is list
        && request.resource.data.primary is int;
    }
    // A quiz (שעשועון) is a titled, ordered selection of riddle ids from the pool, sent as one link.
    match /quizzes/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.cover is string
        && request.resource.data.riddleIds is list;
    }
    // A letter, not tied to any quiz: a sent link names one before the quiz and one after it
    // (index.html?q=<quiz>&b=<letter>&a=<letter>).
    match /letters/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.text is string
        && request.resource.data.image is string;
    }
    // How hard a player found a riddle, marked after answering it. Anyone playing can write one (players are
    // not signed in); only Ori and Carmit read them, in the statistics tab. The id is made up by the player's
    // browser (a random visit id + the riddle), so the same player changing their mind overwrites their own.
    match /ratings/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if id.size() <= 80
        && request.resource.data.keys().hasOnly(['quiz', 'riddle', 'level', 'correct', 'hint', 'created'])
        && request.resource.data.quiz is string && request.resource.data.quiz.size() <= 40
        && request.resource.data.riddle is string && request.resource.data.riddle.size() <= 40
        && request.resource.data.level in ['easy', 'medium', 'hard']
        && request.resource.data.correct is bool
        && request.resource.data.hint is bool
        && request.resource.data.created == request.time
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quiz));
    }
    // A visit: one browser (a random id, nothing about the person), one day, one page (a quiz or the start screen).
    // Written by the game, read only by Ori and Carmit. "own" marks their own browsers.
    match /visits/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if id.size() <= 120
        && request.resource.data.keys().hasOnly(['visitor', 'day', 'quiz', 'solo', 'own', 'started', 'finished', 'created'])
        && request.resource.data.visitor is string && request.resource.data.visitor.size() <= 40
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.quiz is string && request.resource.data.quiz.size() <= 40
        && request.resource.data.solo is bool
        && request.resource.data.own is bool
        && request.resource.data.get('started', true) == true
        && request.resource.data.get('finished', true) == true
        && request.resource.data.created == request.time;
    }
    // A short link (orimosenzon.github.io/fun/carmit/?<code>): which quiz and which letters it opens.
    // Never changed once made, so a link that was sent always opens the same thing.
    match /links/{code} {
      allow read: if true;
      allow create: if isAdmin()
        && code.matches('^[a-z0-9]{4,12}$')
        && request.resource.data.q is string
        && request.resource.data.b is string
        && request.resource.data.a is string;
      allow update, delete: if false;
    }
  }
}
