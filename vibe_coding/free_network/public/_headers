/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; frame-src https:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="free-network.apk"
  Cache-Control: no-cache
