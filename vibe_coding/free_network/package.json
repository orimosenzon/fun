{
  "name": "free-network",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "migrate": "wrangler d1 migrations apply free-network --local",
    "dev": "npm run migrate && mkdir -p logs && wrangler dev --port 8787 --var DEV_LOGIN:1 2>&1 | tee -a logs/dev.log",
    "logs": "node tools/logs.mjs",
    "test": "node tools/test_api.mjs",
    "deploy": "wrangler d1 migrations apply free-network-pilot --env live --remote && wrangler deploy --env live",
    "first-login": "node tools/first_login.mjs",
    "android": "tools/build_android.sh"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.158.0"
  }
}
