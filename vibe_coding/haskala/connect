#!/usr/bin/env bash
# connect — log in to Google Cloud as the haskala work account.
#
# Run this when anything gcloud-shaped starts failing with "Reauthentication
# required" or "invalid_grant". Safe to run any time: if the credentials are
# still good it says so and does nothing.
#
#   ./connect          # log in the gcloud CLI (what deploy.sh and logs.sh need)
#   ./connect --adc    # also refresh application-default credentials
#   ./connect --force  # log in again even if the current credentials work
#   ./connect --browser  # try to launch a browser instead of printing a URL
#
# WHY IT DOES NOT LAUNCH A BROWSER BY DEFAULT
# ───────────────────────────────────────────
# gcloud's browser flow starts a local web server and waits for the browser to
# redirect back to it. On this machine that fails ("There was a problem with web
# authentication"), and the failure wastes a round trip before falling back.
# --no-launch-browser skips the guessing: gcloud prints one URL, you open it,
# and paste the code back. That is the flow that actually works here, so it is
# the default rather than the fallback.
#
# WHY --adc IS NOT THE DEFAULT
# ────────────────────────────
# There are two separate credentials, and most days only one is needed:
#
#   gcloud auth login                    → authorises the gcloud CLI.
#                                          deploy.sh and logs.sh need this.
#   gcloud auth application-default login → writes a credentials file that
#                                          Python's google.auth.default() reads.
#                                          Only needed to run main.py or
#                                          oris-scanner locally.
#
# They expire independently. Refreshing both every time doubles the browser
# round trips for a deploy that never touches the second one, so ADC is opt-in.
#
# WHY THIS KEEPS HAPPENING AT ALL
# ───────────────────────────────
# The credentials expire roughly every 16 hours — the Workspace default for
# Google Cloud session control. No flag fixes that; it is a policy on the
# bdika.net domain:
#
#   admin.google.com → Security → Access and data control
#                    → Google Cloud session control  → set to "Session never
#                      expires"
#
# That one change retires this script. Until then, this is the workaround.
set -euo pipefail

ACCOUNT="${HASKALA_ACCOUNT:-ori@bdika.net}"
PROJECT="${HASKALA_PROJECT:-master-gecko-500709-t0}"
GCLOUD="$HOME/google-cloud-sdk/bin/gcloud"

# Asked for explicitly, and kept to the minimum that works.
#
# gcloud's default ADC login also requests sqlservice.login, which we never use.
# Every extra scope is another checkbox on the consent screen, and every unticked
# checkbox silently downgrades the grant — which surfaces as the genuinely
# unhelpful "gcloud crashed (Warning): Scope has changed from … to …". Fewer
# boxes, fewer ways to lose cloud-platform.
#
# cloud-platform is the one that matters: google.auth.default() feeds
# iam.Signer, which signs as the service account through the IAM API. Without it
# the credentials look fine and every Drive call fails.
ADC_SCOPES="openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/cloud-platform"

[[ -x "$GCLOUD" ]] || GCLOUD="$(command -v gcloud || true)"
if [[ -z "$GCLOUD" ]]; then
    echo "❌ gcloud not found. Expected it at ~/google-cloud-sdk/bin/gcloud." >&2
    exit 1
fi

WANT_ADC=0 FORCE=0 BROWSER_FLAG="--no-launch-browser"
for arg in "$@"; do
    case "$arg" in
        --adc)     WANT_ADC=1 ;;
        --force)   FORCE=1 ;;
        --browser) BROWSER_FLAG="--launch-browser" ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "unknown option: $arg (try --help)" >&2; exit 2 ;;
    esac
done

# A token request is the only honest test. `gcloud auth list` happily shows an
# account whose refresh token expired hours ago — exactly the failure this
# script exists to catch — so checking that instead would report success right
# up until the deploy fails.
cli_ok() { "$GCLOUD" auth print-access-token --account="$ACCOUNT" >/dev/null 2>&1; }
adc_ok() { "$GCLOUD" auth application-default print-access-token >/dev/null 2>&1; }

echo "🔑 account : $ACCOUNT"
echo "   project : $PROJECT"
echo

if [[ $FORCE -eq 0 ]] && cli_ok; then
    echo "✅ gcloud CLI credentials are valid."
else
    echo "→ logging in the gcloud CLI."
    echo "  Copy the URL below into the browser you are already signed in with,"
    echo "  then paste the code it gives you back here."
    echo
    "$GCLOUD" auth login "$ACCOUNT" $BROWSER_FLAG
fi

if [[ $WANT_ADC -eq 1 ]]; then
    if [[ $FORCE -eq 0 ]] && adc_ok; then
        echo "✅ application-default credentials are valid."
    else
        cat <<'BANNER'

  ╔════════════════════════════════════════════════════════════════════╗
  ║  READ THIS BEFORE CLICKING — the consent screen defaults to OFF.   ║
  ║                                                                    ║
  ║  After you sign in, Google shows a list of permissions with        ║
  ║  CHECKBOXES, and they start UNTICKED. Clicking Continue without    ║
  ║  ticking them grants only your email address.                      ║
  ║                                                                    ║
  ║      →  Click "Select all" (בחר הכל) at the top of that list.      ║
  ║                                                                    ║
  ║  If you miss it, the login LOOKS like it worked and then fails     ║
  ║  with "Scope has changed from ... to ...". That message means      ║
  ║  exactly one thing: the boxes were not ticked. Just rerun this.    ║
  ╚════════════════════════════════════════════════════════════════════╝

BANNER
        "$GCLOUD" auth application-default login \
            --scopes="$ADC_SCOPES" $BROWSER_FLAG || true

        # gcloud exits non-zero on the downgraded-scope crash, so the check
        # below is what turns a wall of stack trace into one actionable line.
        if ! adc_ok; then
            echo
            echo "❌ ADC login did not complete." >&2
            echo "   Almost always: the permission boxes were not ticked." >&2
            echo "   Run  ./connect --adc  again and click \"Select all\"." >&2
            exit 1
        fi
    fi
fi

"$GCLOUD" config set account "$ACCOUNT" >/dev/null
"$GCLOUD" config set project "$PROJECT" >/dev/null

echo
if cli_ok; then
    echo "✅ connected as $ACCOUNT on $PROJECT."
    [[ $WANT_ADC -eq 1 ]] && { adc_ok && echo "✅ ADC is valid too." \
                                     || echo "⚠️  ADC still not valid — see the checkbox note above."; }
    echo "   Expires in ~16h. Rerun ./connect when things start failing,"
    echo "   or kill it for good via the admin console (see the header)."
else
    echo "❌ still not authenticated. If the browser step completed but this" >&2
    echo "   still fails, the account may be blocked by an admin policy." >&2
    exit 1
fi
