# רשת ביטחון לכל תת-פרויקט של השכלה (מוצרים + infra).
# gitignore-ים פר-מוצר עדיין קיימים; כאן רק הדפוסים המסוכנים/הגנריים.

# סודות
.env
credentials.json
token.json
service-account*.json

# סביבות והרצה
venv/
.venv/
__pycache__/
*.pyc
*.log

# תוצרים מקומיים
downloads/
uploads/

# הספרייה המשותפת מועתקת לתוך תיקיית המוצר ע"י deploy.sh לפני הפריסה,
# כי `gcloud run deploy --source .` מעלה רק את תיקיית המוצר.
# מקור האמת היחיד הוא lib/haskala_grading/ — העותק המועתק הוא תוצר בנייה
# ונדרס בכל פריסה. לערוך רק ב-lib/.
products/*/haskala_grading/
